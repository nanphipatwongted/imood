---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'imood — เพลงและบรรยากาศสำหรับทำงาน',
  description = 'เลือกฉาก เปิดเพลง และผสมเสียงบรรยากาศให้เข้ากับอารมณ์ตอนทำงาน',
} = Astro.props;

// Crawlers need an absolute og:image URL. Set `site` in astro.config.mjs to the
// production domain before deploying; until then this falls back to the
// request origin (fine locally, wrong for real link previews).
const ogImage = new URL('/og.jpg', Astro.site ?? Astro.url).href;
// Icons and og.jpg are generated by scripts/generate-icons.mjs.
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the scene fill the notch area; App pads with safe-area insets. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Installable app (Add to Home Screen). Service worker: public/sw.js -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="imood" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="imood" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // Production only — a service worker would fight Vite's hot reload in dev.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
